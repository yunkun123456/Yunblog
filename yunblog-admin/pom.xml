<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ssj</groupId>
        <artifactId>YunBlog</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>yunblog-admin</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>yunblog-admin</name>
    <description>yunblog-admin</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.ssj</groupId>
            <artifactId>yunblog-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.ssj</groupId>
            <artifactId>yunblog-module-setting</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.ssj</groupId>
            <artifactId>yunblog-module-file-service</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.ssj</groupId>
            <artifactId>yunblog-module-base-info</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.ssj</groupId>
            <artifactId>yunblog-module-search</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <!-- 环境配置区域：定义不同环境的打包参数 -->
    <profiles>
        <!-- 开发环境配置 -->
        <profile>
            <id>dev</id>  <!-- 环境标识，用于命令行 -P 参数 -->
            <properties>
                <profiles.active>dev</profiles.active>  <!-- 激活的 Spring 环境 -->
                <packaging.type>jar</packaging.type>    <!-- 打包类型 -->
            </properties>
            <activation>
                <activeByDefault>true</activeByDefault>  <!-- 默认激活此环境 -->
            </activation>
        </profile>

        <!-- 生产环境配置 -->
        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>  <!-- 生产环境标识 -->
                <packaging.type>jar</packaging.type>
            </properties>
        </profile>
    </profiles>

    <!-- 构建配置区域 -->
    <build>
        <!-- 资源文件处理配置 -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>  <!-- 资源文件目录 -->
                <filtering>true</filtering>  <!-- 启用占位符替换 -->
                <includes>
                    <include>**/*.xml</include>        <!-- 包含 XML 文件 -->
                    <include>**/*.yml</include>        <!-- 包含 YML 文件 -->
                </includes>
            </resource>
        </resources>

        <!-- 插件配置 -->
        <plugins>
            <!-- Spring Boot 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
